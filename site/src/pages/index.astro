---
import BaseLayout from "../layouts/BaseLayout.astro";

const features = [
  "Small, deterministic grammar with strict EOL token rules",
  "Safety-first semantics with explicit move/copy ownership operations",
  "Function arguments are borrow-by-default with own and inout modes",
  "GC-less by default with compiler-inferred lifetimes (no lifetime annotations)",
  "ref, str, and slice are NonStorable views to prevent accidental retention",
  "Option-first flow: no ?:, ?., or ?? operators",
  "Compile-time const expr evaluation for values and const generics",
  "Protocols, associated types, and some opaque return types"
];
---

<BaseLayout
  title="Nue | Practical Language Design, Sharp Semantics"
  description="Official site for the Nue programming language."
>
  <header class="topbar">
    <a class="brand" href="/">NUE</a>
    <nav class="topnav" aria-label="Main navigation">
      <a href="/docs/getting-started">Docs</a>
      <a href="/playground">Playground</a>
      <a href="/docs/getting-started#language-snapshot">Language</a>
    </nav>
  </header>

  <section class="hero">
    <p class="eyebrow">Small grammar. Strong guarantees.</p>
    <h1>A practical language for reliable software.</h1>
    <p class="lead">
      Nue prioritizes deterministic parsing and explicit semantics. Ownership, borrowing, const
      evaluation, and protocol-based abstraction are designed to stay predictable as systems grow.
    </p>
  </section>

  <section class="feature-panel" aria-labelledby="feature-title">
    <h2 id="feature-title">Why teams are exploring Nue</h2>
    <ul>
      {
        features.map((feature) => (
          <li>{feature}</li>
        ))
      }
    </ul>
  </section>

  <section class="actions" aria-label="Primary actions">
    <a class="button button-primary" href="/docs/getting-started">Read Language Snapshot</a>
    <a class="button button-ghost" href="/playground">Open Playground Notes</a>
  </section>

  <p class="fine-print">
    The compiler implementation currently lives in a private repository at
    <code>$HOME/Developer/Workspace/nue</code>.
  </p>

  <footer class="site-footer">
    <p>Built by the Nue team.</p>
    <form class="subscribe-form" action="#" method="post">
      <label for="email-input">Get monthly build notes</label>
      <div class="subscribe-row">
        <input
          id="email-input"
          name="email"
          type="email"
          placeholder="name@company.com"
          autocomplete="email"
          required
        />
        <button type="submit">Subscribe</button>
      </div>
    </form>
  </footer>
</BaseLayout>
