---
import BaseLayout from "../layouts/BaseLayout.astro";
import Features from "../sections/features.mdx";
---

<BaseLayout
  title="Nue | Practical Language Design, Sharp Semantics"
  description="Official site for the Nue programming language."
>
  <header class="topbar">
    <a class="brand" href="/">NUE</a>
    <nav class="topnav" aria-label="Main navigation">
      <a href="/docs/#language">Language</a>
      <a href="/docs/#roadmap">Roadmap</a>
      <a href="/docs/#faq">FAQ</a>
    </nav>
  </header>

  <section class="hero">
    <p class="eyebrow">Deterministic, explicit, but never boring.</p>
    <h1>A new modern language just for fun.</h1>
    <p class="lead">
      Nue prioritizes deterministic syntax and explicit semantics. Ownership,
      borrowing, const evaluation, and protocol-based abstraction are designed
      to stay predictable as systems grow.
    </p>
  </section>

  <section class="feature-panel" aria-labelledby="feature-title">
    <Features />
  </section>

  <section class="actions" aria-label="Primary actions">
    <a class="button button-primary" href="/docs/getting-started"
      >Read Language Snapshot</a
    >
    <a class="button button-ghost" href="/playground">Open Playground Notes</a>
  </section>

  <p class="fine-print">
    The compiler implementation currently lives in a private repository at
    <code>$HOME/Developer/Workspace/nue</code>.
  </p>

  <footer class="site-footer">
    <p>Built and maintained by me.</p>
    <form class="subscribe-form" action="#" method="post">
      <label for="email-input">Get monthly build notes</label>
      <div class="subscribe-row">
        <input
          id="email-input"
          name="email"
          type="email"
          placeholder="name@company.com"
          autocomplete="email"
          required
        />
        <button type="submit">Subscribe</button>
      </div>
    </form>
  </footer>
</BaseLayout>
