---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Playground | Nue"
  description="Playground implementation notes for Nue."
>
  <header class="topbar">
    <a class="brand" href="/">NUE</a>
    <nav class="topnav" aria-label="Main navigation">
      <a href="/">Home</a>
      <a href="/docs/">Docs</a>
    </nav>
  </header>

  <section class="hero hero-tight">
    <p class="eyebrow">Playground</p>
    <h1>WASM + React Playground</h1>
    <p class="lead">
      I bundle the playground implementation in this repository so deployments
      stay self-contained.
    </p>
  </section>

  <section class="feature-panel">
    <h2>Runtime module</h2>
    <p class="path-chip"><code>site/public/pkg/nue_wasm.js</code></p>
    <p>
      Default wasm assets are bundled under <code>site/public/pkg</code>. You
      can override the module URL with
      <code>PUBLIC_PLAYGROUND_WASM_MODULE_URL</code> when needed.
    </p>
  </section>

  <section class="actions" aria-label="Navigation actions">
    <a class="button button-primary" href="/docs/">Open docs</a>
    <a class="button button-ghost" href="/">Back to landing page</a>
  </section>
</BaseLayout>
