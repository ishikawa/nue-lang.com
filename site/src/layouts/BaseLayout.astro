---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
}

const supportedThemes = ["tuna", "fjord", "newsprint", "signal"] as const;
const requestedTheme =
  (
    globalThis as { process?: { env?: Record<string, string | undefined> } }
  ).process?.env?.PUBLIC_THEME?.toLowerCase() ?? "";
const theme = (supportedThemes as readonly string[]).includes(requestedTheme)
  ? requestedTheme
  : "signal";

const {
  title = "Nue",
  description = "Official site for the Nue programming language.",
  pageClass = ""
} = Astro.props as Props;
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="backdrop" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>
    <main class={`site-shell ${pageClass}`.trim()}>
      <slot />
    </main>
  </body>
</html>
